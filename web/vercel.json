{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/og-image.ts": { "includeFiles": "public/boards/**" }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
